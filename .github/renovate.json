{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly",
    "group:allNonMajor",
    "helpers:disableTypesNodeMajor"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "extends": ["monorepo:octokit"],
      "groupName": "octokit monorepo",
      "separateMajorMinor": false
    }
  ],
  "ignoreDeps": ["node"]
}
